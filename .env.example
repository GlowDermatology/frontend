# Canonical site origin used for metadata, Open Graph, sitemap.xml and robots.txt.
# Falls back to VERCEL_PROJECT_PRODUCTION_URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Data source (seam-mappers) ---
# mock (default) serves the in-memory fixtures; api talks to Django.
GLOWDERMA_DATA_SOURCE=mock
# Django origin, no trailing slash (used only with GLOWDERMA_DATA_SOURCE=api).
GLOWDERMA_API_URL=http://127.0.0.1:8000
# Shared secret sent as X-GD-Internal-Secret; must equal Django INTERNAL_API_SECRET.
GLOWDERMA_INTERNAL_SECRET=change-me

# --- Auth (auth-bff) ---
# Exact host[:port] entries (comma-separated, no scheme, no wildcards) allowed
# to invoke Server Actions and the auth route handlers: the host shown in the
# browser's address bar, e.g. admin.glowderma.uz. Same-origin is always allowed.
# Read when next.config.ts loads (`next build` / `next start`), not per
# request: a change needs a rebuild and restart.
GLOWDERMA_ALLOWED_ORIGINS=localhost:3000
# Session cookies carry Secure and the __Secure- prefix. Set to true behind
# HTTPS (production); false for plain-HTTP local development.
GLOWDERMA_COOKIE_SECURE=false
# Hostnames (comma-separated host[:port]) that next/image may optimise, i.e.
# Django's PUBLIC_MEDIA_BASE_URL host. Empty → no remote images. Also read when
# next.config.ts loads (build/start), not per request.
GLOWDERMA_MEDIA_HOSTS=
# Stable key shared by every Next instance so encrypted Server Action
# references decrypt everywhere. Required when more than one Next instance runs.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
