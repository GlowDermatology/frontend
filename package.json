    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "uqr": "0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "openapi-typescript": "7.13.0",
