# Build context for the Docker image: sources, lockfile, entrypoint. Nothing else.
.git
.github
.next
node_modules
coverage
out
build
*.tsbuildinfo
.env*
!.env.example
npm-debug.log*
.DS_Store
Dockerfile
.dockerignore
README.md
AGENTS.md
# Tests are not part of the image. playwright.config.ts imports ./e2e/env and tsconfig includes **/*.ts, so it
# must go together with e2e/ or `next build` fails its type check.
e2e
playwright.config.ts
vitest.config.mts
src/**/*.test.ts
test-results
playwright-report
