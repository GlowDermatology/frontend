# Canonical site origin used for metadata, Open Graph, sitemap.xml and robots.txt.
# Falls back to VERCEL_PROJECT_PRODUCTION_URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Data source (seam-mappers) ---
# mock (default) serves the in-memory fixtures; api talks to Django.
GLOWDERMA_DATA_SOURCE=mock
# Django origin, no trailing slash (used only with GLOWDERMA_DATA_SOURCE=api).
GLOWDERMA_API_URL=http://127.0.0.1:8000
# Shared secret sent as X-GD-Internal-Secret; must equal Django INTERNAL_API_SECRET.
GLOWDERMA_INTERNAL_SECRET=change-me

# --- Storefront (W3a) ---
# The live storefront at /, /ru, /en needs GLOWDERMA_DATA_SOURCE=api; mock mode
# keeps the static landing and answers 404 on the shop pages.
# Bearer secret of POST /api/revalidate (cache tags for the backend or the
# admin). At least 32 characters; unset → the route answers 404.
GLOWDERMA_REVALIDATE_SECRET=

# --- Storefront sign-in and payment (W3b) ---
# Public client ids of the customer's social sign-in (read per request; a
# provider without its id gets no button). The secrets stay in Django.
GLOWDERMA_SHOP_GOOGLE_CLIENT_ID=
GLOWDERMA_SHOP_FACEBOOK_APP_ID=
# Apple: the Services ID and its registered https redirect URI (= Django APPLE_WEB_REDIRECT_URI).
GLOWDERMA_SHOP_APPLE_SERVICES_ID=
GLOWDERMA_SHOP_APPLE_REDIRECT_URI=
# Local development and e2e only: "To‘lash" opens a test panel that simulates the
# provider (backend dev/payments/{id}/simulate/, FAKE_PAYMENTS_ENABLED=true). Never in production.
GLOWDERMA_PAYMENT_SANDBOX=
# Second opt-in a production server (next start, the image) needs for the sandbox.
GLOWDERMA_PAYMENT_SANDBOX_ALLOW=
# Clinic facts for the MedicalClinic JSON-LD the API does not carry (optional;
# a malformed value is ignored): opening hours "Mo-Fr 09:00-20:00; Sa 10:00-18:00"
# and "latitude,longitude" (used when no specialist location has coordinates).
GLOWDERMA_SHOP_OPENING_HOURS=
GLOWDERMA_SHOP_GEO=

# --- Auth (auth-bff) ---
# Exact host[:port] entries (comma-separated, no scheme, no wildcards) allowed
# to invoke Server Actions and the auth route handlers: the host shown in the
# browser's address bar: the admin AND the storefront hosts, e.g.
# www.glowderma.uz,admin.glowderma.uz. Same-origin is always allowed.
# Build AND runtime: `next build` bakes it into the Server Action check (the
# standalone server never re-reads next.config.ts) and the auth route
# handlers read it per request. Set the same value in both; a change needs a
# rebuild.
GLOWDERMA_ALLOWED_ORIGINS=localhost:3000
# Session cookies carry Secure and the __Secure- prefix. Set to true behind
# HTTPS (production); false for plain-HTTP local development.
GLOWDERMA_COOKIE_SECURE=false
# Hostnames (comma-separated host[:port]) that next/image may optimise, i.e.
# Django's PUBLIC_MEDIA_BASE_URL host. Empty → no remote images. Build-time
# (baked by `next build`).
GLOWDERMA_MEDIA_HOSTS=
# Local development only: lets next/image fetch from a media host that
# resolves to a private IP (e.g. GLOWDERMA_MEDIA_HOSTS=localhost:8001). Leave
# unset in production.
GLOWDERMA_MEDIA_ALLOW_LOCAL=
# Build-time, optional: `next build` embeds the Server Action encryption key,
# so all containers started from one image share it already. Set a base64
# AES key here only to share it across separately built images.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- Staff social sign-in (contract §2.1, M0b) ---
# All of them are read per request (runtime): no rebuild needed to change them.
# Comma-separated providers that get a button on the login page and a
# Bog‘lash/Uzish row on the account card: google, facebook. Empty = none.
GLOWDERMA_OAUTH_PROVIDERS=
# live: redirect to Google / Facebook (pair with Django OAUTH_MODE=live) —
# the production value.
# fake: the authorize step is the built-in page
# /admin/auth/oauth/{provider}/fake (pair with Django OAUTH_MODE=fake); the
# login buttons say "(sinov)". Fake mode signs in anyone who types a linked
# subject — never use it on a public deployment.
# Unset means fake only when NODE_ENV is development or test (next dev); on
# any other server (next start, NODE_ENV=staging, …) providers without an
# explicit mode are disabled (warning in the log).
GLOWDERMA_OAUTH_MODE=
# Outside development fake mode also needs this second opt-in (a test
# deployment only); the server then logs a warning once.
GLOWDERMA_OAUTH_ALLOW_FAKE=
# Public OAuth client ids (live mode only; the secrets stay in Django:
# GOOGLE_OAUTH_CLIENT_SECRET, FACEBOOK_APP_SECRET). A live provider without
# its id is left out with a server warning.
GLOWDERMA_GOOGLE_CLIENT_ID=
GLOWDERMA_FACEBOOK_APP_ID=
# redirect_uri = <scheme>://<host>/admin/auth/oauth/{provider}/callback, where
# host is the request host when it is in GLOWDERMA_ALLOWED_ORIGINS (else the
# first entry) and the scheme is https when GLOWDERMA_COOKIE_SECURE=true.
# Register that URL with the provider and set Django's per-provider setting to
# it: GOOGLE_OAUTH_REDIRECT_URI=https://<admin host>/admin/auth/oauth/google/callback
# and FACEBOOK_OAUTH_REDIRECT_URI=https://<admin host>/admin/auth/oauth/facebook/callback
# (the single OAUTH_REDIRECT_URI is deprecated since the backend's M2).

# --- Build metadata ---
# Build-time: commit SHA of the image. Enables Next's deploymentId (open
# browser tabs reload instead of failing after a release) and is reported by
# GET /healthz. Leave empty locally.
GLOWDERMA_BUILD_SHA=
